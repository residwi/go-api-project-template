# Application
APP_NAME=ecommerce-api
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=30s
# Comma-separated CIDRs of the reverse proxies / load balancers in front of
# this app. X-Forwarded-For and X-Real-IP are trusted ONLY for peers in these
# CIDRs. Leave it empty and the app trusts NO forwarding headers: it keys every
# request on the immediate connection address, so a caller cannot spoof its
# rate-limit key. Only the listed CIDRs are trusted, so list every hop,
# including a sidecar proxy on 127.0.0.1/32.
# MUST be set whenever a proxy fronts the app. If it stays empty behind a proxy,
# every client arrives as the proxy's single address and shares ONE auth
# rate-limit bucket, so one attacker hammering /auth/login can 429 every user's
# login, register and refresh. (The app logs a one-time warning if it sees
# forwarding headers from an internal peer while this is empty.)
TRUSTED_PROXIES=
MAX_CART_ITEMS=50
ORDER_RATE_LIMIT=5
ORDER_RATE_WINDOW=1m

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TX_SESSION_TIMEOUT=60s
REPLICA_DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
# Generate a unique value: openssl rand -hex 32
# Boot fails if this is left as the placeholder or is shorter than 32 bytes.
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=ecommerce-api

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,Idempotency-Key
CORS_MAX_AGE=86400

# Worker
WORKER_RESCUE_AFTER=5m

PAYMENT_JOB_INTERVAL=10s
PAYMENT_JOB_CONCURRENCY=5
PAYMENT_JOB_TIMEOUT=2m

NOTIFICATION_JOB_INTERVAL=5s
NOTIFICATION_JOB_CONCURRENCY=10
NOTIFICATION_JOB_TIMEOUT=30s

ORDER_JOB_INTERVAL=1m
ORDER_JOB_CONCURRENCY=1
ORDER_JOB_TIMEOUT=2m

# Payment
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_URL=http://localhost:8080/mock/payment
PAYMENT_GATEWAY_TIMEOUT=10s
PAYMENT_GATEWAY_API_KEY=
# Generate a unique value: openssl rand -hex 32
# Boot fails if this is empty, the default below, or shorter than 32 bytes.
PAYMENT_WEBHOOK_SECRET=webhook-secret

# Auth tuning
# AUTH_RATE_WINDOW must be >= 1s -- auth.LoadConfig() fails fast below that,
# as a deliberate minimum window.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
BCRYPT_COST=10

# Redis connection pool
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_POOL_TIMEOUT=1s

# Tracing: "none" (the default, same as unset) registers no provider; "otlp" with an endpoint turns it on, or "console" prints spans to stdout.
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SERVICE_NAME=
